# Example environment variables. Copy to `.env` for local overrides (git-ignored).
# Production boot validates the required ones and fails fast naming any that are
# missing (see config/runtime.exs). Never commit real secrets.

# --- Required in production ---
# Ecto database URL, e.g. ecto://USER:PASS@HOST/DATABASE
DATABASE_URL=

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname the app is served from, e.g. example.com
PHX_HOST=

# Secret used to sign/verify AshAuthentication tokens (JWTs, magic links).
# Generate with: mix phx.gen.secret
TOKEN_SIGNING_SECRET=

# Mailgun credentials for the production mailer (config/runtime.exs). Get these
# from your Mailgun dashboard; DOMAIN is your verified sending domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Optional (have sane defaults) ---
# HTTP port (default 4000)
PORT=4000

# DB connection pool size (default 10)
POOL_SIZE=10

# Set to "true" or "1" to bind the DB socket over IPv6
ECTO_IPV6=

# libcluster DNS query for multi-node clustering (blank = disabled)
DNS_CLUSTER_QUERY=
