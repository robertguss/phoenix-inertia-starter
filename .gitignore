# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
starter_kit-*.tar

# Dialyzer PLT files: machine-specific and large. CI caches priv/plts by mix.lock.
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Local environment files — never commit real secrets. See .env.example.
.env
.env.*
!.env.example

# Node modules for the Vite/React assets (web flavor).
/assets/node_modules/

# Vite owns priv/static entirely: hashed assets + manifest from the build, and
# passthrough files (favicon.ico, robots.txt) copied from assets/public. All
# generated — the source of truth is assets/.
/priv/static/


# Local codebase knowledge graph (auto-regenerated; machine-local).
.codebase-memory/
