#!/usr/bin/env elixir

# bin/new_project — births a new project from this template (KTD4). Copies the
# template, renames the three name casings, prunes to the chosen flavor, installs
# deps, sets up the database, and runs the full quality gate so the newborn is
# proven green with zero manual steps (R21, R22, R23).
#
#   bin/new_project my_app --web            # Inertia + React + TS web project
#   bin/new_project my_app --api            # JSON:API-only project (frontend pruned)
#   bin/new_project my_app --api --dir ../x # explicit target directory
#   bin/new_project my_app --web --skip-gate
#
# The flavor flag is required — no default, so an agent must be explicit. On a red
# gate the newborn is left in place with the failing step printed.

defmodule NewProject do
  @moduledoc """
  Births a new project from this template: copies the tree, renames the name
  casings, prunes to the chosen flavor, installs deps, sets up the database, and
  runs the quality gate so the newborn is proven green. See the header comment.
  """

  @template_root File.cwd!()
  @reserved ~w(phoenix ash ecto oban elixir mix)

  # Node major installed into the release Dockerfile builder — phoenix_vite shells
  # out to npm, which the Elixir builder image lacks. Matches the CI pin
  # (.github/workflows/*.yml) and assets/package.json's @types/node.
  @node_major 24

  # Template-only artifacts a newborn should never carry.
  @always_delete ~w(
    bin/new_project
    docs/github-settings.md
    docs/plans
    docs/refresh.md
    .github/workflows/birth-matrix.yml
  )

  # Whole web-only files/dirs deleted for --api (relative to the newborn root, with
  # `APP` standing in for the renamed app name). Colocated prune manifest (KTD5).
  @api_delete [
    "assets",
    "lib/APP_web/controllers/page_controller.ex",
    "lib/APP_web/controllers/auth",
    "lib/APP_web/controllers/note_controller.ex",
    "lib/APP_web/plugs/inertia_share.ex",
    "lib/APP_web/plugs/require_authenticated.ex",
    "lib/APP_web/components/layouts.ex",
    "lib/APP_web/components/layouts",
    "test/APP_web/controllers",
    "test/e2e"
  ]

  def main(argv) do
    {name, flavor, dir, skip_gate?} = parse!(argv)
    names = casings(name)
    target = Path.expand(dir || "../#{names.app}", @template_root)

    ensure_target!(target)
    check_binaries!(flavor)
    info("Birthing #{names.app} (#{flavor}) into #{target}")

    copy_template!(target)
    Enum.each(@always_delete, &File.rm_rf!(Path.join(target, &1)))
    rename!(target, names)
    process_flavor!(target, flavor, names)
    write_newborn_readme!(target, names, flavor)
    prune_empty_dirs(target)

    setup!(target, flavor)
    unless skip_gate?, do: verify!(target, flavor)

    next_steps(target, names, flavor, skip_gate?)
  end

  # --- args -----------------------------------------------------------------

  defp parse!(argv) do
    {opts, rest, invalid} =
      OptionParser.parse(argv, strict: [web: :boolean, api: :boolean, dir: :string, skip_gate: :boolean])

    if invalid != [], do: usage!("unknown option: #{inspect(invalid)}")

    {name!(rest), flavor!(opts), opts[:dir], opts[:skip_gate] || false}
  end

  defp name!(rest) do
    case rest do
      [name] -> name
      [] -> usage!("missing project NAME")
      _ -> usage!("expected exactly one NAME, got: #{inspect(rest)}")
    end
  end

  defp flavor!(opts) do
    case {opts[:web], opts[:api]} do
      {true, nil} -> :web
      {nil, true} -> :api
      {nil, nil} -> usage!("a flavor flag is required: --web or --api")
      _ -> usage!("--web and --api are mutually exclusive")
    end
  end

  defp usage!(message) do
    IO.puts(:stderr, """
    error: #{message}

    usage: bin/new_project NAME (--web | --api) [--dir PATH] [--skip-gate]
    """)

    System.halt(2)
  end

  # --- name casings ---------------------------------------------------------

  defp casings(name) do
    app =
      name
      |> String.downcase()
      |> String.replace(~r/[^a-z0-9]+/, "_")
      |> String.trim("_")

    validate!(app)

    %{
      app: app,
      module: Macro.camelize(app),
      slug: String.replace(app, "_", "-"),
      concat: String.replace(app, "_", "")
    }
  end

  defp validate!(app) do
    cond do
      app == "" ->
        usage!("NAME must contain at least one letter or digit")

      not Regex.match?(~r/^[a-z][a-z0-9_]*$/, app) ->
        usage!("NAME must start with a letter and use only letters, digits, and underscores")

      app in @reserved ->
        usage!("NAME #{inspect(app)} is reserved (#{Enum.join(@reserved, ", ")})")

      # "<app>_test" must fit Postgres's 63-byte identifier limit.
      String.length(app) > 58 ->
        usage!("NAME is too long (max 58 characters)")

      true ->
        :ok
    end
  end

  # --- copy + rename --------------------------------------------------------

  defp ensure_target!(target) do
    if File.dir?(target) and File.ls!(target) != [] do
      usage!("target directory #{target} already exists and is not empty")
    end

    File.mkdir_p!(target)
  end

  defp copy_template!(target) do
    # Copy EXACTLY the git-tracked files, at their current working-tree content (F7).
    # `git ls-files` is the only reliable "what git keeps" source: an rsync
    # `:- .gitignore` filter is a superset — it drops files re-included by a `!`
    # negation (e.g. `.env.example` under `.env.*`/`!.env.example`) AND copies
    # untracked, non-ignored cruft/secrets that `git init && git add -A` would then
    # commit into the newborn. Feed the NUL-delimited tracked list to rsync so build
    # dirs (_build, deps, node_modules, priv/static) and stray files never appear.
    list = Path.join(System.tmp_dir!(), "new_project_files_#{System.unique_integer([:positive])}")

    try do
      {tracked, 0} = System.cmd("git", ["ls-files", "-z"], cd: @template_root)
      File.write!(list, tracked)

      {_, 0} =
        System.cmd(
          "rsync",
          ["-a", "--from0", "--files-from=#{list}", "./", target <> "/"],
          cd: @template_root
        )
    after
      File.rm(list)
    end
  end

  # Fail with a named, friendly message if a tool the birth actually shells out to is
  # missing, instead of letting a `{_, 0} = System.cmd(...)` MatchError escape. docker
  # is NOT required — birth generates the Dockerfile but never builds it.
  defp check_binaries!(flavor) do
    required = ~w(git mix rsync) ++ if(flavor == :web, do: ["npm"], else: [])

    for bin <- required, is_nil(System.find_executable(bin)) do
      die("required executable #{inspect(bin)} not found on PATH — install it and retry", 1)
    end
  end

  defp rename!(target, names) do
    # Replace file contents first (paths still carry the template name), then move
    # the paths themselves. Order of tokens is irrelevant — none is a substring of
    # another in a way that collides.
    for path <- text_files(target) do
      replaced =
        path
        |> File.read!()
        |> String.replace("StarterKit", names.module)
        |> String.replace("starterkit", names.concat)
        |> String.replace("starter_kit", names.app)
        |> String.replace("starter-kit", names.slug)

      File.write!(path, replaced)
    end

    rename_paths(target, names.app)
  end

  defp text_files(target) do
    target
    |> all_paths()
    |> Enum.filter(&File.regular?/1)
    |> Enum.reject(&binary_file?/1)
  end

  # Skip anything with a NUL byte in its first chunk (images, etc.).
  defp binary_file?(path) do
    case File.open(path, [:read, :binary], fn io -> IO.binread(io, 8000) end) do
      {:ok, :eof} -> false
      {:ok, chunk} -> String.contains?(chunk, <<0>>)
      _ -> true
    end
  end

  defp rename_paths(target, app) do
    case Enum.find(all_paths(target), &String.contains?(Path.basename(&1), "starter_kit")) do
      nil ->
        :ok

      path ->
        renamed = String.replace(Path.basename(path), "starter_kit", app)
        File.rename!(path, Path.join(Path.dirname(path), renamed))
        rename_paths(target, app)
    end
  end

  defp all_paths(target), do: Path.wildcard(Path.join(target, "**/*"), match_dot: true)

  # --- flavor pruning -------------------------------------------------------

  defp process_flavor!(target, :api, names) do
    Enum.each(@api_delete, fn rel ->
      File.rm_rf!(Path.join(target, String.replace(rel, "APP", names.app)))
    end)

    prune_empty_dirs(target)
    apply_markers(target, :api)
    info("Pruned the web surface for the --api flavor")
  end

  defp process_flavor!(target, :web, _names) do
    apply_markers(target, :web)
  end

  defp write_newborn_readme!(target, names, flavor) do
    File.write!(Path.join(target, "README.md"), newborn_readme(names, flavor))
  end

  defp newborn_readme(names, :web) do
    """
    # #{names.module}

    Phoenix 1.8 / Ash 3 application with an Inertia + React + TypeScript web UI
    and a JSON:API surface under `/api/v1`.

    ## Quickstart

    ```bash
    mix setup        # first run after a fresh clone
    mix phx.server
    ```

    Open <http://localhost:4000>. API docs are available at
    <http://localhost:4000/api/v1/docs>.

    ## Quality Gate

    ```bash
    mix precommit
    ```

    The gate runs format checks, compile with warnings as errors, migration drift
    checks, Credo, Sobelow, dependency audit, tests, and Dialyzer. Browser E2E tests
    are tagged separately:

    ```bash
    mix test --only playwright
    ```

    ## Demo Slice

    The starter ships with a small Notes feature so the project has a working
    vertical slice on day one. Remove it once you have real features:

    ```bash
    bin/remove_demo
    ```

    ## Deploy

    A production `Dockerfile` is generated and committed during project birth:

    ```bash
    docker build .
    ```

    Regenerate it only when you intentionally refresh release settings:

    ```bash
    mix phx.gen.release --docker --force
    ```
    """
  end

  defp newborn_readme(names, :api) do
    """
    # #{names.module}

    Phoenix 1.8 / Ash 3 JSON:API application. Resources are exposed under
    `/api/v1`, with Swagger UI at `/api/v1/docs`.

    ## Quickstart

    ```bash
    mix setup        # first run after a fresh clone
    mix phx.server
    ```

    Open <http://localhost:4000/api/v1/docs> for API documentation.

    ## Quality Gate

    ```bash
    mix precommit
    ```

    The gate runs format checks, compile with warnings as errors, migration drift
    checks, Credo, Sobelow, dependency audit, tests, and Dialyzer.

    ## Demo Slice

    The starter ships with a small Notes API feature so the project has a working
    vertical slice on day one. Remove it once you have real resources:

    ```bash
    bin/remove_demo
    ```

    ## Deploy

    A production `Dockerfile` is generated and committed during project birth:

    ```bash
    docker build .
    ```

    Regenerate it only when you intentionally refresh release settings:

    ```bash
    mix phx.gen.release --docker --force
    ```
    """
  end

  # `# PRUNE:WEB` .. `# PRUNE:END` blocks: --api drops the whole block, --web keeps
  # the enclosed code and drops only the marker lines. Either way no marker survives.
  defp apply_markers(target, flavor) do
    for path <- text_files(target), String.contains?(File.read!(path), "PRUNE:WEB") do
      lines = path |> File.read!() |> String.split("\n")

      kept =
        case flavor do
          :api -> drop_blocks(lines)
          :web -> Enum.reject(lines, &marker_line?/1)
        end

      File.write!(path, Enum.join(kept, "\n"))
    end
  end

  defp drop_blocks(lines) do
    {kept, _} =
      Enum.reduce(lines, {[], false}, fn line, {acc, skipping?} ->
        cond do
          String.contains?(line, "PRUNE:WEB") -> {acc, true}
          String.contains?(line, "PRUNE:END") -> {acc, false}
          skipping? -> {acc, true}
          true -> {[line | acc], false}
        end
      end)

    Enum.reverse(kept)
  end

  defp marker_line?(line), do: String.contains?(line, "PRUNE:WEB") or String.contains?(line, "PRUNE:END")

  defp prune_empty_dirs(target) do
    target
    |> all_paths()
    |> Enum.filter(&File.dir?/1)
    |> Enum.sort_by(&(-String.length(&1)))
    |> Enum.each(fn dir -> if File.ls!(dir) == [], do: File.rmdir(dir) end)
  end

  # --- setup + verify -------------------------------------------------------

  defp setup!(target, flavor) do
    mix!(target, ["deps.get"], "fetching dependencies")

    if flavor == :api do
      mix!(target, ["deps.unlock", "--unused"], "shedding pruned deps from mix.lock")
    end

    mix!(target, ["compile"], "compiling (the rename verifier)")
    # Create + migrate the dev database so `mix phx.server` works first-run (F9).
    # Runs for both flavors and regardless of --skip-gate — this is setup, not a gate.
    mix!(target, ["ash.setup"], "creating and migrating the dev database")
    mix!(target, ["usage_rules.sync", "--yes"], "syncing AGENTS.md for the flavor")

    if flavor == :web do
      npm!(target, ["ci"], "installing npm packages")
      npm!(target, ["run", "typecheck"], "type-checking the frontend")
      npm!(target, ["run", "build"], "building the frontend")
    end

    # Ship a production release Dockerfile so the newborn is deployable day one (F3,
    # KTD-R1). --api omits the assets lines (generator gates them on assets/ existing);
    # --web needs Node + an install-after-copy fixup, see patch_dockerfile!/1.
    mix!(target, ["phx.gen.release", "--docker", "--force"], "generating the release Dockerfile")
    patch_dockerfile_runtime!(target)
    if flavor == :web, do: patch_dockerfile!(target)

    # Format last so the generator's lib/*/release.ex is gate-clean too.
    mix!(target, ["format"], "formatting")

    git_init!(target)
  end

  # The Phoenix builder is a Node-less Elixir image, but this template's
  # assets.setup/deploy shell out to npm (phoenix_vite). Two problems to fix in the
  # generated web Dockerfile: (1) no Node in the builder; (2) the generator emits
  # `RUN mix assets.setup` (= `npm install`) BEFORE `COPY assets assets`, so there's
  # no package.json yet. We install Node in a cached layer and move the npm install
  # to right before the asset build, after the copy.
  defp patch_dockerfile!(target) do
    path = Path.join(target, "Dockerfile")
    lines = path |> File.read!() |> String.split("\n")

    # Anchors Phoenix emits for a project WITH an assets/ dir. If a future generator
    # drops them, fail loud instead of shipping a Node-less image that dies at build.
    for anchor <- ["RUN mix deps.compile", "RUN mix assets.deploy"], anchor not in lines do
      die("Dockerfile patch anchor #{inspect(anchor)} not found — phx.gen.release output changed; update bin/new_project", 1)
    end

    node_install = [
      "",
      "# Node.js + npm for the phoenix_vite (Vite) asset pipeline, absent from the",
      "# Elixir builder image. Pinned to Node #{@node_major} (matches CI + @types/node).",
      "RUN apt-get update \\",
      "  && apt-get install -y --no-install-recommends curl \\",
      "  && curl -fsSL https://deb.nodesource.com/setup_#{@node_major}.x | bash - \\",
      "  && apt-get install -y --no-install-recommends nodejs \\",
      "  && rm -rf /var/lib/apt/lists/*"
    ]

    patched =
      lines
      # Drop the generator's premature `RUN mix assets.setup` (runs before the copy).
      |> Enum.reject(&(&1 == "RUN mix assets.setup"))
      |> Enum.flat_map(fn
        "RUN mix deps.compile" = l -> [l | node_install]
        # Re-add setup right before deploy, now that assets/ have been copied.
        "RUN mix assets.deploy" = l -> ["RUN mix assets.setup", l]
        l -> [l]
      end)

    File.write!(path, Enum.join(patched, "\n"))
    info("Patched Dockerfile: Node #{@node_major} in builder, npm install after asset copy")
  end

  defp patch_dockerfile_runtime!(target) do
    path = Path.join(target, "Dockerfile")
    versions = runtime_versions!(target)

    patched =
      path
      |> File.read!()
      |> replace_docker_arg!("ELIXIR_VERSION", versions.elixir)
      |> replace_docker_arg!("OTP_VERSION", versions.erlang)

    File.write!(path, patched)
    info("Pinned Dockerfile runtime to Elixir #{versions.elixir} / Erlang #{versions.erlang}")
  end

  defp runtime_versions!(target) do
    lines =
      target
      |> Path.join(".tool-versions")
      |> File.read!()
      |> String.split("\n", trim: true)

    elixir =
      lines
      |> tool_version!("elixir")
      |> String.replace(~r/-otp-\d+$/, "")

    %{elixir: elixir, erlang: tool_version!(lines, "erlang")}
  end

  defp tool_version!(lines, tool) do
    case Enum.find_value(lines, &tool_version(&1, tool)) do
      nil -> die(".tool-versions is missing #{tool}", 1)
      version -> version
    end
  end

  defp tool_version(line, tool) do
    case String.split(line, ~r/\s+/, parts: 2) do
      [^tool, version] -> String.trim(version)
      _ -> nil
    end
  end

  defp replace_docker_arg!(contents, arg, value) do
    pattern = ~r/^ARG #{arg}=.+$/m

    if Regex.match?(pattern, contents) do
      Regex.replace(pattern, contents, "ARG #{arg}=#{value}")
    else
      die("Dockerfile ARG #{arg} not found — phx.gen.release output changed; update bin/new_project", 1)
    end
  end

  defp verify!(target, _flavor) do
    info("Running the quality gate (`mix precommit`)...")

    case System.cmd("mix", ["precommit"], cd: target, into: IO.stream(:stdio, :line)) do
      {_, 0} -> info("Gate green.")
      {_, status} -> die("the quality gate failed — the newborn is at #{target}", status)
    end
  end

  defp git_init!(target) do
    {_, 0} = System.cmd("git", ["init", "-q"], cd: target)
    {_, 0} = System.cmd("git", ["add", "-A"], cd: target)

    {_, 0} =
      System.cmd(
        "git",
        # -c commit.gpgsign=false so a user's global signing config can't hang/fail birth.
        ["-c", "commit.gpgsign=false", "commit", "-q", "-m", "Initial commit from starter template"],
        cd: target,
        env: [{"GIT_AUTHOR_NAME", "new_project"}, {"GIT_AUTHOR_EMAIL", "new_project@example.com"},
         {"GIT_COMMITTER_NAME", "new_project"}, {"GIT_COMMITTER_EMAIL", "new_project@example.com"}]
      )
  end

  defp mix!(target, args, what) do
    info(what)

    case System.cmd("mix", args, cd: target, into: IO.stream(:stdio, :line)) do
      {_, 0} -> :ok
      {_, status} -> die("`mix #{Enum.join(args, " ")}` failed while #{what}", status)
    end
  end

  defp npm!(target, args, what) do
    info(what)
    assets = Path.join(target, "assets")

    case System.cmd("npm", args, cd: assets, into: IO.stream(:stdio, :line)) do
      {_, 0} -> :ok
      {_, status} -> die("`npm #{Enum.join(args, " ")}` failed while #{what}", status)
    end
  end

  # --- output ---------------------------------------------------------------

  defp info(msg), do: IO.puts("• #{msg}")

  defp die(msg, status) do
    IO.puts(:stderr, "\nerror: #{msg}")
    System.halt(status)
  end

  defp next_steps(target, names, flavor, skip_gate?) do
    surface =
      if flavor == :web,
        do: "Inertia + React web UI at /",
        else: "JSON:API at /api/v1 (docs at /api/v1/docs)"

    IO.puts("""

    #{names.module} is born (#{flavor}).

      cd #{Path.relative_to_cwd(target)}
    #{if skip_gate?, do: "  mix precommit          # verify the gate (skipped)\n", else: ""}\
      mix phx.server         # #{surface} (deps + dev DB are ready)
      docker build .         # a production Dockerfile is generated and ready

    The demo Notes slice ships inside — run `bin/remove_demo` once you have real
    features. Build with an agent: point it at AGENTS.md.
    """)
  end
end

NewProject.main(System.argv())
